{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "python3 .cursor/hooks/block-env-access.py",
        "matcher": "Read|Grep|Glob|Shell",
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": "python3 .cursor/hooks/block-env-access.py",
        "failClosed": true
      }
    ],
    "beforeTabFileRead": [
      {
        "command": "python3 .cursor/hooks/block-env-access.py",
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/block-env-access.py",
        "matcher": "\\.env",
        "failClosed": true
      }
    ]
  }
}
