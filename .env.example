# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="Web Assistant"
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Langfuse Settings
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com
# Preferred in Langfuse SDK v4+; LANGFUSE_HOST remains supported for compatibility
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# LLM Settings
OPENAI_API_KEY="your-llm-api-key" # e.g. OpenAI API key
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_LLM_TEMPERATURE=0.2

# Bifrost API Gateway (https://docs.getbifrost.ai/integrations/langchain-sdk)
# Set BIFROST_ENABLED=true to route all LLM calls through Bifrost
BIFROST_ENABLED=false
# LangChain SDK proxy endpoint (use http://bifrost:8080/langchain when app runs in Docker)
BIFROST_BASE_URL=http://localhost:8081/langchain
# OpenAI-compatible endpoint for mem0, evaluations, and direct OpenAI clients
BIFROST_OPENAI_BASE_URL=http://localhost:8081/v1
# Dummy key when Bifrost manages provider credentials
BIFROST_API_KEY=dummy-key
# Optional governance virtual key (sent as x-bf-vk header)
BIFROST_VIRTUAL_KEY=

# JWT Settings
JWT_SECRET_KEY="your-jwt-secret-key"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Database Settings
POSTGRES_HOST=db
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PORT=5432
POSTGRES_PASSWORD=mypassword
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console

# Long-Term Memory (mem0)
# Optional natural-language guidelines for what mem0 should extract or ignore
# LONG_TERM_MEMORY_CUSTOM_INSTRUCTIONS="Extract user preferences, goals, and constraints. Exclude personal identifiers."

# MCP
MCP_ENABLED=true
MCP_SERVER_PORT=7001
MCP_HOSTNAMES_CSV=mcp:7001
