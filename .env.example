# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="Agent Harness for production"
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Langfuse Settings
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com
# Preferred in Langfuse SDK v4+; LANGFUSE_HOST remains supported for compatibility
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# LLM Settings
OPENAI_API_KEY="your-llm-api-key" # e.g. OpenAI API key
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-5.6-luna
DEFAULT_LLM_REASONING_EFFORT=low
DEFAULT_LLM_TEMPERATURE=0.2

# AWS Bedrock (https://docs.aws.amazon.com/bedrock/latest/userguide/setting-up.html)
# Set DEFAULT_LLM_PROVIDER=bedrock and DEFAULT_LLM_MODEL to a Bedrock model id
# DEFAULT_LLM_PROVIDER=bedrock
# DEFAULT_LLM_MODEL=us.anthropic.claude-3-7-sonnet-20250219-v1:0
# AWS_REGION=us-east-1
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Bifrost API Gateway (https://docs.getbifrost.ai/integrations/langchain-sdk)
# Set BIFROST_ENABLED=true to route all LLM calls through Bifrost
BIFROST_ENABLED=true
# LangChain SDK proxy endpoint (use http://bifrost:8080/langchain when app runs in Docker)
BIFROST_BASE_URL=http://localhost:8090/langchain
# Dummy key when Bifrost manages provider credentials
BIFROST_API_KEY=dummy-key
# Optional global governance virtual key fallback (sent as x-bf-vk header)
# BIFROST_VIRTUAL_KEY=
# Per-agent Bifrost virtual keys (sent as x-bf-vk header)
BIFROST_API_KEY_AGENT_1=sk-bf-agent-1-dev
BIFROST_API_KEY_AGENT_2=sk-bf-agent-2-dev

# JWT Settings
JWT_SECRET_KEY="your-jwt-secret-key"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Database Settings
POSTGRES_HOST=localhost
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PORT=5432
POSTGRES_PASSWORD=mypassword
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console

# Long-Term Memory (mem0)
# Optional natural-language guidelines for what mem0 should extract or ignore
# LONG_TERM_MEMORY_CUSTOM_INSTRUCTIONS="Extract user preferences, goals, and constraints. Exclude personal identifiers."

# MCP
MCP_ENABLED=true
MCP_SERVER_PORT=7001
MCP_HOSTNAMES_CSV=http://mcp:7001/mcp
MCP_ENDPOINT_PATH=/mcp
MCP_PROTOCOL_MODE=auto
MCP_TOOL_CACHE_MODE=use


# Long term memory
LONG_TERM_MEMORY_MODEL=gpt-5-nano
LONG_TERM_MEMORY_EMBEDDER_MODEL=text-embedding-3-small
LONG_TERM_MEMORY_COLLECTION_NAME=longterm_memory
LONG_TERM_MEMORY_CUSTOM_INSTRUCTIONS="Extract user preferences, goals, and constraints. Exclude personal identifiers."

# Redis (semantic cache requires Redis Stack with RediSearch module)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=30
REDIS_SOCKET_CONNECT_TIMEOUT=30
REDIS_DECODE_RESPONSES=true

# Response cache (exact + semantic confidence scoring)
CACHE_TTL_HOURS=6
CACHE_SEMANTIC_ENABLED=true
CACHE_SEMANTIC_SEARCH_TOP_K=5
CACHE_SEMANTIC_SIMILARITY_THRESHOLD=0.7
CACHE_CONFIDENCE_THRESHOLD=0.90
CACHE_WEIGHT_EXACT=0.10
CACHE_WEIGHT_FUZZY=0.20
CACHE_WEIGHT_SEMANTIC=0.70
CACHE_EMBEDDING_DIMENSIONS=1536
CACHE_KEY_PREFIX=agent_cache
# Defaults to LONG_TERM_MEMORY_EMBEDDER_MODEL when unset
# CACHE_EMBEDDER_MODEL=text-embedding-3-small

